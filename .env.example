# Copy to .env for local testing with a real Postgres, or set these in the
# Vercel dashboard (Project -> Settings -> Environment Variables) for production.
# Never commit a real .env file.

# Postgres connection string. If you use Vercel's own "Storage -> Create
# Database -> Postgres" integration, it sets POSTGRES_URL for you automatically
# and you can leave DATABASE_URL unset.
DATABASE_URL=

# Random long string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin dashboard login (Report a Bug -> /admin/bug-reports.html). Generate the
# hash locally with: node scripts/hash-password.js "your-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
